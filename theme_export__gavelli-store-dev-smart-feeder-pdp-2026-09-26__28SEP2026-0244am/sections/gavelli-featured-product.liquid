{%- comment -%}
  GAVELLI — featured product (editorial).
  Shows one product as a calm, image-led story with a single link to the
  product page. Renders nothing on the storefront when the product is not
  available to customers (e.g. still a draft); shows a note in the editor.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign image = section.settings.image | default: product.featured_media.preview_image
-%}

{%- if product != blank -%}
  {%- style -%}
    .gv-feature-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .gv-feature-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <style>
    .gv-feature__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4rem;
      align-items: center;
    }

    @media screen and (min-width: 990px) {
      .gv-feature__inner {
        grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        gap: 9.6rem;
      }

      .gv-feature--image-right .gv-feature__media {
        order: 2;
      }
    }

    .gv-feature__media {
      display: block;
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: rgba(var(--color-foreground), 0.05);
    }

    .gv-feature__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    @media (hover: hover) {
      .gv-feature__media:hover img {
        transform: scale(1.025);
      }
    }

    .gv-feature__placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(var(--color-foreground), 0.14);
    }

    .gv-feature__placeholder svg {
      width: 44%;
      height: auto;
    }

    .gv-feature__content {
      max-width: 48rem;
    }

    .gv-feature__title {
      margin: 0;
      font-size: calc(var(--font-heading-scale) * 3.6rem);
    }

    @media screen and (min-width: 750px) {
      .gv-feature__title {
        font-size: calc(var(--font-heading-scale) * 4.8rem);
      }
    }

    .gv-feature__text {
      margin-top: 2.4rem;
      color: rgba(var(--color-foreground), 0.78);
    }

    .gv-feature__text p {
      margin: 0 0 1.2rem;
    }

    .gv-feature__price {
      margin: 2.4rem 0 0;
      font-size: 1.5rem;
      letter-spacing: 0.04em;
      color: rgba(var(--color-foreground), 0.85);
    }

    .gv-feature__link {
      margin-top: 3.6rem;
    }
  </style>

  <div class="gv-feature gv-feature-{{ section.id }} gv-feature--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width gv-feature__inner">
      <a href="{{ product.url }}" class="gv-feature__media" tabindex="-1" aria-hidden="true">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 55vw, calc(100vw - 3rem)',
              alt: product.title
          }}
        {%- else -%}
          <span class="gv-feature__placeholder">{{ 'gavelli-logo-full.svg' | inline_asset_content }}</span>
        {%- endif -%}
      </a>

      <div class="gv-feature__content">
        {%- if section.settings.preheading != blank -%}
          <p class="gv-eyebrow">{{ section.settings.preheading | escape }}</p>
        {%- endif -%}
        <h2 class="gv-feature__title">{{ section.settings.heading | default: product.title | escape }}</h2>

        {%- if section.settings.text != blank -%}
          <div class="gv-feature__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.show_price -%}
          <p class="gv-feature__price">
            {%- if product.price_varies -%}
              {{ 'products.product.price.from_price_html' | t: price: product.price_min | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
        {%- endif -%}

        <div class="gv-feature__link">
          <a href="{{ product.url }}" class="gv-link">
            {{- section.settings.link_label | default: product.title | escape -}}
          </a>
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 4rem 0;">
    <p class="gv-todo">GAVELLI featured product: choose a product. It only appears to customers once the product is active.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "GAVELLI featured product",
  "class": "section-gavelli-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Defaults to the product's first image."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "GAVELLI featured product"
    }
  ]
}
{% endschema %}
