{%- comment -%}
  GAVELLI — "A day, considered" (sticky storytelling).
  Brand storytelling, not data or testimonials: four moments in an ordinary
  day with a pet.
  ≥990px: an editorial spread — the photograph (about half the width) stays
          in place while the moments scroll beside it; the photograph for
          the moment in the middle of the screen fades in.
  750–989px: each moment is a spread of photograph and words side by side.
  <750px: a natural vertical sequence (each moment shows its own photograph).
  No scroll-jacking: the page scrolls normally; JS only marks the active step.
  Without JS or with reduced motion, content is fully readable.
{%- endcomment -%}

<style>
  .gv-day__head { display: grid; gap: 2rem; max-width: var(--gv-measure-lg); }
  .gv-day__intro { margin-top: 0.4rem; }

  .gv-day__layout { margin-top: var(--gv-space-sm); }

  .gv-day__visual { display: none; }

  .gv-day__steps { margin: 0; padding: 0; list-style: none; }

  .gv-day__step + .gv-day__step { margin-top: var(--gv-space-md); }

  .gv-day__step-media { margin: 0 -1.5rem 3.2rem; }

  .gv-day__time {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    letter-spacing: 0.2em;
    color: rgba(var(--color-foreground), 0.78);
    font-variant-numeric: tabular-nums;
  }

  .gv-day__time::after {
    content: '';
    flex: 0 0 4rem;
    height: 1px;
    background: rgba(var(--color-foreground), 0.35);
  }

  .gv-day__title { margin-top: 1.6rem; }
  .gv-day__text { margin-top: 1.6rem; }

  /* Tablet (750–989px): each moment is a spread — photograph and words side
     by side, the words centred against the photograph. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .gv-day__step {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: var(--gv-gap);
      align-items: center;
    }

    .gv-day__step-media { margin: 0; }
  }

  /* Desktop (>= 990px): photograph and words as one editorial spread.
     - The photograph takes about half the composition and stays in place
       while the four moments scroll beside it.
     - Its frame fills the height left under the header. It is 4:5 on tall
       screens and never wider than 5:4 on short laptop screens, so a square
       photograph with the subject in its central area works everywhere.
     - Each moment is only as tall as needed for a calm change of photograph
       (about 60% of the frame), and the first and last moments line up with
       the middle of the frame: no empty screen before or after.
     The page scrolls normally; JS only marks the active moment. */
  @media screen and (min-width: 990px) {
    .gv-day {
      --gv-day-top: 10rem;
      --gv-day-marks: 4.4rem;
      --gv-day-h: clamp(44rem, calc(100svh - var(--gv-day-top) - var(--gv-day-marks) - 2.4rem), 84rem);
      --gv-day-step: calc(var(--gv-day-h) * 0.6);
    }

    .gv-day__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      column-gap: var(--gv-gap-lg);
      align-items: start;
    }

    .gv-day__visual {
      display: block;
      position: sticky;
      top: var(--gv-day-top);
    }

    .gv-day__stage {
      container-type: inline-size;
      width: min(100%, var(--gv-day-h) * 1.25);
    }

    .gv-day__frame {
      position: relative;
      width: 100%;
      height: var(--gv-day-h);
      height: min(var(--gv-day-h), 125cqi);
      overflow: hidden;
      background: rgba(var(--color-foreground), 0.05);
    }

    .gv-day__frame-item {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: scale(1.03);
      transition: opacity 1.2s var(--gv-ease-out), transform 2.4s var(--gv-ease-out);
    }

    .gv-day__frame-item.is-active {
      opacity: 1;
      transform: scale(1);
    }

    .gv-day__frame-item img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* The day's progress, under the photograph and as wide as it. */
    .gv-day__marks {
      display: grid;
      grid-template-columns: repeat(var(--gv-day-count, 4), minmax(0, 1fr));
      gap: 1.2rem;
      margin: 1.6rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 1.15rem;
      letter-spacing: 0.18em;
      font-variant-numeric: tabular-nums;
    }

    .gv-day__marks li {
      position: relative;
      padding-top: 1rem;
      color: rgba(var(--color-foreground), 0.66);
      transition: color var(--gv-dur) var(--gv-ease);
    }

    /* A hairline per moment; the active one draws in from the left. */
    .gv-day__marks li::before,
    .gv-day__marks li::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: rgba(var(--color-foreground), 0.18);
    }

    .gv-day__marks li::after {
      background: rgb(var(--color-foreground));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.9s var(--gv-ease-out);
    }

    .gv-day__marks li.is-active { color: rgb(var(--color-foreground)); }
    .gv-day__marks li.is-active::after { transform: scaleX(1); }

    /* Words sit a gutter away from the photograph. The column's padding
       centres the first moment on the photograph when it settles and the
       last moment when it leaves. */
    .gv-day__steps {
      width: 100%;
      max-width: 48rem;
      padding-top: calc((var(--gv-day-h) - var(--gv-day-step)) / 2);
      padding-bottom: calc((var(--gv-day-h) - var(--gv-day-step)) / 2 + var(--gv-day-marks));
    }

    .gv-day__step {
      min-height: var(--gv-day-step);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .gv-day__step + .gv-day__step { margin-top: 0; }

    .gv-day__step-media { display: none; }

    .gv-day__step-body { transition: opacity 0.9s var(--gv-ease); }

    .gv-day[data-active] .gv-day__step:not(.is-active) .gv-day__step-body { opacity: 0.32; }

    /* Keyboard users always get the full-strength text. */
    .gv-day__step:focus-within .gv-day__step-body { opacity: 1; }

    .gv-day__title { font-size: clamp(2.8rem, 1.6rem + 1.4vw, 3.6rem); }
  }
</style>

<section
  id="{{ section.settings.anchor | default: 'day' | handleize }}"
  class="gv-day color-{{ section.settings.color_scheme }} gradient gv-pt-{{ section.settings.spacing_top }} gv-pb-{{ section.settings.spacing_bottom }}"
  data-gv-day
  aria-labelledby="GvDay-{{ section.id }}"
>
  <div class="page-width">
    <header class="gv-day__head">
      {%- if section.settings.label != blank -%}
        <p class="gv-label" data-gv-reveal="fade">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 id="GvDay-{{ section.id }}" class="gv-h2" data-gv-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}
        <div class="gv-lede gv-day__intro" data-gv-reveal style="--gv-delay: 0.1s;">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="gv-day__layout">
      <div class="gv-day__visual" aria-hidden="true" style="--gv-day-count: {{ section.blocks.size }};" data-gv-reveal="fade">
        <div class="gv-day__stage">
        <div class="gv-day__frame">
          {%- for block in section.blocks -%}
            <div class="gv-day__frame-item{% if forloop.first %} is-active{% endif %}" data-gv-visual>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag: loading: 'lazy', widths: '700, 1000, 1400, 1800', sizes: '(min-width: 990px) 46vw, 1px', alt: ''
                }}
              {%- else -%}
                <div class="gv-placeholder">
                  <span class="gv-placeholder__label">{{ block.settings.time | escape }} · Photograph to come</span>
                  <span class="gv-placeholder__note">{{ block.settings.placeholder_note | escape }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <ol class="gv-day__marks">
          {%- for block in section.blocks -%}
            <li data-gv-mark{% if forloop.first %} class="is-active"{% endif %}>{{ block.settings.time | escape }}</li>
          {%- endfor -%}
        </ol>
        </div>
      </div>

      <ol class="gv-day__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="gv-day__step{% if forloop.first %} is-active{% endif %}" data-gv-step {{ block.shopify_attributes }}>
            <div class="gv-day__step-media">
              <div class="gv-media" style="--gv-ratio: 4 / 5;" data-gv-reveal="media">
                {%- if block.settings.image != blank -%}
                  {%- assign step_alt = block.settings.image_alt | default: block.settings.image.alt -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 1px, (min-width: 750px) 50vw, 100vw', alt: step_alt
                  }}
                {%- else -%}
                  <div class="gv-placeholder" role="img" aria-label="{{ block.settings.placeholder_note | escape }}">
                    <span class="gv-placeholder__label">Photograph to come</span>
                    <span class="gv-placeholder__note">{{ block.settings.placeholder_note | escape }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>
            <div class="gv-day__step-body">
              <p class="gv-day__time" data-gv-reveal="fade"><time datetime="{{ block.settings.time | strip | escape }}">{{ block.settings.time | escape }}</time></p>
              <h3 class="gv-h3 gv-day__title" data-gv-reveal>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <div class="gv-body gv-day__text" data-gv-reveal style="--gv-delay: 0.1s;">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GAVELLI a day, considered",
  "class": "section-gavelli-day",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "A day, considered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The small moments make the day." },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "anchor", "label": "Anchor (for links)", "default": "day" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    {
      "type": "select", "id": "spacing_top", "label": "Space above",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "lg"
    },
    {
      "type": "select", "id": "spacing_bottom", "label": "Space below",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "lg"
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "text", "id": "time", "label": "Time", "default": "07:30" },
        { "type": "text", "id": "title", "label": "Title", "default": "A calmer start." },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Square 1:1, ideally 2400 × 2400 px (at least 2000 × 2000). Keep the subject within the central area: the photograph is shown from 4:5 (phones, tablets, tall screens) to 5:4 (laptops). Set a focal point in Content > Files if needed." },
        { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Describe the photograph. Leave blank to use the image's own alt text." },
        { "type": "textarea", "id": "placeholder_note", "label": "Photograph needed (shown until an image is added)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GAVELLI a day, considered",
      "blocks": [
        { "type": "moment", "settings": { "time": "07:30", "title": "A calmer start." } },
        { "type": "moment", "settings": { "time": "12:40", "title": "A moment of calm." } },
        { "type": "moment", "settings": { "time": "18:20", "title": "Back home." } },
        { "type": "moment", "settings": { "time": "22:15", "title": "Time to settle." } }
      ]
    }
  ]
}
{% endschema %}