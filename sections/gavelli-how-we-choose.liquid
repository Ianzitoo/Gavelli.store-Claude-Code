{%- comment -%}
  GAVELLI — "How we choose" (short proof of the philosophy).
  One statement, an optional link, and optional plain facts (blocks). A fact
  is only rendered when it has both a title and text — add delivery, returns
  or payment facts only once they are real, confirmed policies.
  Touch targets: links get an invisible hit area of at least 44px (see ::before below).
{%- endcomment -%}

<style>
  .gv-hwc__statement {
    margin-top: 1.6rem;
    max-width: 30ch;
    font-size: var(--gv-t-statement);
    line-height: 1.16;
    text-wrap: balance;
  }

  .gv-hwc .gv-body { margin-top: 2rem; max-width: var(--gv-measure-sm); }
  .gv-hwc__link { margin-top: 2.4rem; }
  .gv-hwc__link .gv-link { padding-top: 1.2rem; padding-bottom: 0.8rem; }

  /* Invisible hit area: at least 44px tall around each link, no visual change. */
  .gv-hwc .gv-link::before {
    content: '';
    position: absolute;
    top: -1.1rem;
    bottom: -1.1rem;
    left: -0.8rem;
    right: -0.8rem;
  }

  .gv-hwc__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: var(--gv-space-xs) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(var(--color-foreground), 0.16);
  }

  .gv-hwc__fact {
    display: grid;
    gap: 0.8rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
  }

  .gv-hwc__fact .gv-body { margin: 0; font-size: 1.5rem; }
  .gv-hwc__fact .gv-link { justify-self: start; padding-top: 0.8rem; padding-bottom: 0.6rem; }

  @media screen and (min-width: 750px) {
    .gv-hwc__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--gv-gap); border-top: 0; }
    .gv-hwc__fact { border-top: 1px solid rgba(var(--color-foreground), 0.16); border-bottom: 0; padding: 2.4rem 0 0; }
  }
</style>

<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="gv-hwc color-{{ section.settings.color_scheme }} gradient gv-pt-{{ section.settings.spacing_top }} gv-pb-{{ section.settings.spacing_bottom }}"
  aria-labelledby="GvHwc-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.label != blank -%}
      <p class="gv-label">{{ section.settings.label | escape }}</p>
    {%- endif -%}
    <h2 id="GvHwc-{{ section.id }}" class="gv-h2 gv-hwc__statement">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="gv-body">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <div class="gv-hwc__link"><a class="gv-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></div>
    {%- endif -%}

    {%- liquid
      assign fact_count = 0
      for block in section.blocks
        if block.settings.title != blank and block.settings.text != blank
          assign fact_count = fact_count | plus: 1
        endif
      endfor
    -%}
    {%- if fact_count > 0 -%}
      <ul class="gv-hwc__facts" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank and block.settings.text != blank -%}
            <li class="gv-hwc__fact" {{ block.shopify_attributes }}>
              <p class="gv-label">{{ block.settings.title | escape }}</p>
              <p class="gv-body">{{ block.settings.text | escape }}</p>
              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a class="gv-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GAVELLI how we choose",
  "class": "section-gavelli-how-we-choose",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "How we choose" },
    { "type": "textarea", "id": "heading", "label": "Statement", "default": "We look at what a product does, how it fits into everyday life, and whether it earns its place at home." },
    { "type": "richtext", "id": "text", "label": "Text (optional)" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "anchor", "label": "Anchor (for links)", "default": "how-we-choose" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    {
      "type": "select", "id": "spacing_top", "label": "Space above",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "md"
    },
    {
      "type": "select", "id": "spacing_bottom", "label": "Space below",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "info": "E.g. Contact. Only add facts that are real and confirmed." },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "GAVELLI how we choose" }]
}
{% endschema %}
