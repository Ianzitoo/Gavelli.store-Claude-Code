{%- comment -%}
  GAVELLI — homepage, "Good to know" (Phase B).
  The questions that come just before leaving: delivery, returns, set-up,
  questions. Text only (no lorry, shield or star icons). Every line must
  match the published policies, and none promises a response time.

  - Phones: label and value pairs on ruled lines.
  - Desktop: heading in columns 1–3, the facts in four columns across 5–12.
{%- endcomment -%}

<section
  class="gvh gvh-know color-{{ section.settings.color_scheme }} gradient"
  id="{{ section.settings.anchor | default: 'good-to-know' | handleize }}"
  aria-labelledby="GvhKnowHeading-{{ section.id }}"
>
  <div class="page-width gvh-know__grid">
    <div class="gvh-know__head" data-gv-reveal>
      <h2 class="gvh-h2-sm gvh-know__heading" id="GvhKnowHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="gv-link gvh-know__link" href="{{ section.settings.link | default: '/pages/faq' }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="gvh-know__list" data-gv-reveal>
        {%- for block in section.blocks -%}
          <div class="gvh-know__item" {{ block.shopify_attributes }}>
            <dt class="gv-label gvh-know__label">{{ block.settings.label | escape }}</dt>
            <dd class="gvh-know__value">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.value | escape }}</a>
              {%- else -%}
                {{ block.settings.value | escape }}
              {%- endif -%}
            </dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home · Good to know",
  "tag": "div",
  "class": "section-gvh-know",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "Read the FAQ"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link destination",
      "info": "Defaults to /pages/faq"
    },
    {
      "type": "paragraph",
      "content": "Each line must match the published delivery and returns policies. Do not promise a response time."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "good-to-know"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Delivery"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Free to UK addresses. 5–10 working days."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. The value becomes a link, e.g. to the contact page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home · Good to know",
      "blocks": [
        { "type": "fact", "settings": { "label": "Delivery", "value": "Free to UK addresses. 5–10 working days." } },
        { "type": "fact", "settings": { "label": "Returns", "value": "14 days to change your mind." } },
        { "type": "fact", "settings": { "label": "Set-up", "value": "2.4GHz home WiFi and the app for iOS or Android." } },
        { "type": "fact", "settings": { "label": "Questions", "value": "Write to us before you order.", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
