{%- comment -%}
  GAVELLI — homepage collection (v2).
  A permanent section fed by one Shopify collection. The card never changes;
  the composition follows how many products there are:

  - 1 product: the card, and beside it the same product's in-use
    photograph (the product's custom.in_use_image metafield, or the
    photograph set here). With neither, the card sits alone on the right.
  - 2: two cards set apart, the second a step lower, so they read as two
    things rather than a comparison.
  - 3: one row of three.
  - 4 or more: one row of four; "Shop all" appears only when the
    collection holds more than the cards shown.
  - Phones: one card at full width; two or more become one row swiped
    sideways, the next card always showing at the edge.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
  assign count = 0
  if collection != blank
    assign count = collection.products.size
    if count > limit
      assign count = limit
    endif
  endif

  assign layout = count
  if count > 4
    assign layout = 4
  endif

  assign in_use = blank
  assign in_use_product = blank
  if count == 1
    assign in_use_product = collection.products.first
    assign in_use = in_use_product.metafields.custom.in_use_image.value | default: section.settings.in_use_image
  endif

  assign solo = false
  if count == 1 and in_use == blank and section.settings.show_placeholder == false
    assign solo = true
  endif

  case layout
    when 1
      assign sizes = '(min-width: 990px) 30vw, (min-width: 750px) 46vw, calc(100vw - 4rem)'
    when 2
      assign sizes = '(min-width: 990px) 38vw, (min-width: 750px) 46vw, 78vw'
    when 3
      assign sizes = '(min-width: 990px) 30vw, (min-width: 750px) 30vw, 78vw'
    else
      assign sizes = '(min-width: 990px) 22vw, (min-width: 750px) 46vw, 78vw'
  endcase
-%}

{%- if count > 0 -%}
  <section
    class="gvh gvh-coll gvh-coll--n{{ layout }}{% if solo %} gvh-coll--solo{% endif %} gvh-pad-lg color-{{ section.settings.color_scheme }} gradient"
    id="{{ section.settings.anchor | default: 'collection' | handleize }}"
    aria-labelledby="GvhCollHeading-{{ section.id }}"
  >
    <div class="page-width gvh-coll__layout">
      <div class="gvh-coll__head" data-gv-reveal>
        <div class="gvh-coll__titles">
          {%- if section.settings.label != blank -%}
            <p class="gv-label">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          <h2 class="gvh-h2 gvh-coll__heading" id="GvhCollHeading-{{ section.id }}">
            {{- section.settings.heading | default: collection.title | escape -}}
          </h2>
        </div>
        {%- if collection.products_count > count and section.settings.link_label != blank -%}
          <a class="gv-link gvh-coll__all" href="{{ collection.url }}">
            {{- section.settings.link_label | escape }} {{ collection.products_count -}}
          </a>
        {%- endif -%}
      </div>

      <ul class="gvh-coll__list" role="list">
        {%- for product in collection.products limit: count -%}
          <li class="gvh-coll__item" data-gv-reveal>
            {%- render 'gvh-product-card',
              product: product,
              sizes: sizes,
              show_alt: true,
              fit: section.settings.image_fit
            -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if count == 1 and solo == false -%}
        <a
          class="gvh-coll__inuse gv-media"
          href="{{ in_use_product.url }}"
          tabindex="-1"
          aria-hidden="true"
          data-gv-reveal="media"
        >
          {%- if in_use != blank -%}
            {%- liquid
              assign focal = in_use.presentation.focal_point | default: '50% 50%'
              assign focal_style = '--gv-focal: ' | append: focal | append: ';'
            -%}
            {{
              in_use
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 44vw, 46vw',
                alt: '',
                style: focal_style
            }}
          {%- else -%}
            <span class="gvh-placeholder">
              <span class="gvh-placeholder__label">
                Placeholder · in-use photograph not yet shot<br>
                The product where it lives, with the animal it is meant for
              </span>
            </span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 4rem 1.5rem;">
    <p class="gv-todo">GAVELLI home: collection. Choose a collection with at least one product available on the online store.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Home · Collection",
  "tag": "div",
  "class": "section-gvh-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Useful, and good to live with.",
      "info": "Leave blank to use the collection's title."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "The desktop row holds four; more wrap to a second row."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link to the full collection",
      "default": "Shop all",
      "info": "Shown with the number of products, and only when the collection holds more than the cards shown."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product photographs",
      "options": [
        { "value": "cover", "label": "Fill the frame" },
        { "value": "contain", "label": "Whole product on the Stone ground" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "One product"
    },
    {
      "type": "image_picker",
      "id": "in_use_image",
      "label": "In-use photograph",
      "info": "Used beside the card while the collection has one product, if the product has no custom.in_use_image metafield. 4:5."
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholders",
      "default": false,
      "info": "Labels the missing in-use photograph for review. Turn off before publishing."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "collection",
      "info": "Lets other links jump here, e.g. #collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Home · Collection"
    }
  ]
}
{% endschema %}
