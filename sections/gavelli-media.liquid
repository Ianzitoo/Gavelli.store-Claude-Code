{%- comment -%}
  GAVELLI — media / demonstration (reusable).
  A large Shopify-hosted video or photograph with an optional caption.
  Video: muted, inline, no sound; autoplays in a loop only when the visitor
  has not asked for reduced motion (otherwise shows controls and the poster).
  Loads lazily (preload="none" / loading="lazy"). Renders nothing when empty.
{%- endcomment -%}

{%- liquid
  assign video = section.settings.video
  assign image = section.settings.image
  case section.settings.ratio
    when 'wide'
      assign ratio = '16 / 9'
    when 'landscape'
      assign ratio = '3 / 2'
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
  endcase
-%}

{%- if video != blank or image != blank -%}
  <style>
    .gv-mediasec__frame { margin: 0 -1.5rem; }
    .gv-mediasec video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .gv-mediasec__caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.6rem; margin-top: 2rem; }
    .gv-mediasec__caption .gv-h3 { max-width: 24ch; }
    @media screen and (min-width: 750px) {
      .gv-mediasec__frame { margin: 0; }
      .gv-mediasec--bleed .gv-mediasec__frame { margin: 0 -5rem; }
    }
  </style>

  <section class="gv-mediasec{% if section.settings.full_bleed %} gv-mediasec--bleed{% endif %} color-{{ section.settings.color_scheme }} gradient gv-pt-{{ section.settings.spacing_top }} gv-pb-{{ section.settings.spacing_bottom }}">
    <div class="page-width">
      {%- if section.settings.label != blank -%}
        <p class="gv-label" style="margin-bottom: 2rem;" data-gv-reveal="fade">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <div class="gv-mediasec__frame">
        <div class="gv-media{% if image != blank and video == blank %} gv-scroll-scale{% endif %}" style="--gv-ratio: {{ ratio }};" data-gv-reveal="media">
          {%- if video != blank -%}
            {%- assign poster = video.preview_image | image_url: width: 1600 -%}
            <video
              playsinline
              muted
              loop
              preload="none"
              poster="{{ poster }}"
              data-gv-autoplay
              aria-label="{{ section.settings.alt | default: video.alt | escape }}"
            >
              {%- for source in video.sources -%}
                {%- if source.mime_type == 'video/mp4' -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endif -%}
              {%- endfor -%}
            </video>
          {%- else -%}
            {{
              image
              | image_url: width: 2400
              | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.alt | default: image.alt
            }}
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="gv-mediasec__caption" data-gv-reveal>
          {%- if section.settings.heading != blank -%}<h2 class="gv-h3">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="gv-body">{{ section.settings.text }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if video != blank -%}
    <script>
      (function () {
        var v = document.currentScript.previousElementSibling.querySelector('video[data-gv-autoplay]');
        if (!v) return;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) { v.controls = true; return; }
        new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(function () { v.controls = true; }); }
            else { v.pause(); }
          });
        }, { threshold: 0.25 }).observe(v);
      })();
    </script>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="page-width gv-pt-sm gv-pb-sm"><p class="gv-todo">GAVELLI media: choose a video or photograph to show this section.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "GAVELLI media",
  "class": "section-gavelli-media",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (Shopify-hosted)" },
    { "type": "image_picker", "id": "image", "label": "Photograph (used when no video)" },
    { "type": "text", "id": "alt", "label": "Description for screen readers" },
    {
      "type": "select", "id": "ratio", "label": "Proportions",
      "options": [{ "value": "wide", "label": "16:9" }, { "value": "landscape", "label": "3:2" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "4:5" }],
      "default": "wide"
    },
    { "type": "checkbox", "id": "full_bleed", "label": "Full width", "default": true },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Caption heading" },
    { "type": "richtext", "id": "text", "label": "Caption text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "spacing_top", "label": "Space above",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "md"
    },
    {
      "type": "select", "id": "spacing_bottom", "label": "Space below",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "md"
    }
  ],
  "presets": [{ "name": "GAVELLI media" }]
}
{% endschema %}
