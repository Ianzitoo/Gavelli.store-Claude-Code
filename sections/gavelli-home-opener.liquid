{%- comment -%}
  GAVELLI — homepage opener (hero).

  The photograph is the first thing seen, at every width; the type sits on
  the ground beside or below it, never on it (the current photographs have
  no calm area to carry type).

  - Desktop (>= 990px): split. Type in the left five columns, bottom-aligned;
    the photograph fills the right of the first screen and runs to the edge,
    with a very slight scroll drift (CSS only).
  - Tablet (750–989px): the horizontal photograph at its own proportions,
    then the type below it.
  - Phones: the vertical photograph first, sized so the heading and the
    button still land in the first screen; the lede is left to the page
    below (the label already says what Gavelli is).

  No fixed heights: the photograph's height follows the viewport, clamped.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign alt = section.settings.image_alt | default: image.alt | escape

  assign ratio = '16 / 9'
  if image != blank
    assign ratio = image.aspect_ratio
  endif

  assign focal = image.presentation.focal_point | default: '50% 50%'
  assign focal_mobile = image_mobile.presentation.focal_point | default: '50% 50%'
  assign media_style = '--gv-focal: ' | append: focal | append: '; --gvh-focal-mobile: ' | append: focal_mobile | append: '; --gvh-ratio: ' | append: ratio | append: ';'
-%}

<section class="gvh gvh-opener color-{{ section.settings.color_scheme }} gradient">
  <div class="gvh-opener__media{% if section.settings.parallax %} gvh-opener__media--drift{% endif %}" style="{{ media_style }}">
    <div class="gvh-opener__layer">
      {%- if image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{- image_mobile | image_url: width: 500 }} 500w,
                {{ image_mobile | image_url: width: 750 }} 750w,
                {{ image_mobile | image_url: width: 1000 }} 1000w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1000, 1400, 1800, 2400',
              sizes: '(min-width: 990px) 60vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: alt
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="gvh-opener__text">
    <div class="gvh-opener__head gv-enter">
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h1 class="gvh-display gvh-opener__heading">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank %} <span class="gvh-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="gvh-lede gvh-opener__lede small-hide">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
        <div class="gvh-opener__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="gv-link small-hide" href="{{ section.settings.link }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home · Opener",
  "tag": "div",
  "class": "section-gvh-opener",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Essentials for dogs and cats"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For the life you share"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic ending",
      "default": "with them."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Desktop and tablet only. Keep to one or two lines."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Our story",
      "info": "Desktop and tablet only."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Horizontal. On desktop it fills the right of the first screen, cropped around the focal point, so set the focal point on the subject."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photograph on phones",
      "info": "Vertical (3:4 or 4:5). Shown first on phones, cropped a little from top and bottom."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Slight drift while scrolling",
      "info": "Desktop and tablet only. Off for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Home · Opener"
    }
  ]
}
{% endschema %}
