{%- comment -%}
  GAVELLI — homepage opener (hero).

  Two layouts, chosen for the photograph rather than fixed by the design:
  - stacked (default): the heading sits on the ground above a full-bleed
    photograph. Nothing is ever set on the photograph, so no overlay is
    needed. Right for the current photograph, which has no calm area behind
    the type.
  - overlay: the heading sits on the photograph's lower left. Only for a
    photograph composed for it: subject in the right third, a quiet, darker
    lower left (path, wall, shade), horizon high. "Legibility" adds a small,
    localised shade behind the text and is 0 by default.

  Phones always show the text on the ground (above the photograph when
  stacked, below it when overlay).

  The teaser card links the first product from the first screen. It is a
  solid card, so it stays legible on any photograph; hidden on phones.
  No fixed heights: the photograph keeps its own proportions, capped by the
  viewport height.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'stacked'
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign alt = section.settings.image_alt | default: image.alt | escape

  assign ratio = '16 / 9'
  if image != blank
    assign ratio = image.aspect_ratio
  endif
  assign ratio_mobile = '4 / 5'
  if image_mobile != blank
    assign ratio_mobile = image_mobile.aspect_ratio | at_least: 0.66
  endif

  assign focal = image.presentation.focal_point | default: '50% 50%'
  assign focal_style = '--gv-focal: ' | append: focal | append: ';'

  assign teaser = section.settings.teaser_product
  assign scrim = section.settings.legibility | divided_by: 100.0
-%}

{%- capture head -%}
  <div class="gvh-opener__head gvh-grid gv-enter">
    <div class="gvh-opener__title">
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h1 class="gvh-display">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank %} <span class="gvh-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h1>
    </div>
    <div class="gvh-opener__aside">
      {%- if section.settings.text != blank -%}
        <p class="gvh-lede gvh-opener__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
        <div class="gvh-opener__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="gv-link{% if section.settings.hide_link_mobile %} small-hide{% endif %}" href="{{ section.settings.link }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

{%- capture media -%}
  <div
    class="gvh-opener__media"
    style="--gvh-ratio: {{ ratio }}; --gvh-ratio-mobile: {{ ratio_mobile }};"
  >
    {%- if image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{- image_mobile | image_url: width: 500 }} 500w,
              {{ image_mobile | image_url: width: 750 }} 750w,
              {{ image_mobile | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 2800
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2200, 2800',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: alt,
            style: focal_style
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if layout == 'overlay' and scrim > 0 -%}
      <span class="gvh-opener__scrim" style="--gvh-scrim: {{ scrim }};" aria-hidden="true"></span>
    {%- endif -%}

    {%- if layout == 'overlay' -%}
      <div class="gvh-opener__overlay small-hide">
        <div class="page-width">{{ head }}</div>
      </div>
    {%- endif -%}

    {%- if teaser != blank -%}
      <div class="gvh-teaser-wrap">
        <div class="page-width gvh-teaser-row">
          <a class="gvh-teaser" href="{{ teaser.url }}">
            <span class="gvh-teaser__media">
              {%- assign teaser_image = teaser.featured_media.preview_image -%}
              {%- if teaser_image != blank -%}
                {{ teaser_image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', sizes: '104px', alt: '' }}
              {%- endif -%}
            </span>
            <span class="gvh-teaser__body">
              {%- if section.settings.teaser_label != blank -%}
                <span class="gvh-teaser__label">{{ section.settings.teaser_label | escape }}</span>
              {%- endif -%}
              <span class="gvh-teaser__title">{{ section.settings.teaser_title | default: teaser.title | escape }}</span>
              {%- if section.settings.teaser_text != blank -%}
                <span class="gvh-teaser__text">{{ section.settings.teaser_text | escape }}</span>
              {%- endif -%}
              <span class="gvh-teaser__price">
                {%- if teaser.price_varies -%}
                  {{ 'products.product.price.from_price_html' | t: price: teaser.price_min | money }}
                {%- else -%}
                  {{ teaser.price | money }}
                {%- endif -%}
              </span>
            </span>
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

<section
  class="gvh gvh-opener gvh-opener--{{ layout }} gvh-opener--{{ section.settings.overlay_tone }} color-{{ section.settings.color_scheme }} gradient"
>
  {%- if layout == 'overlay' -%}
    {{ media }}
    <div class="page-width gvh-phone-only">{{ head }}</div>
  {%- else -%}
    <div class="page-width">{{ head }}</div>
    {{ media }}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Home · Opener",
  "tag": "div",
  "class": "section-gvh-opener",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Stacked: heading above the photograph" },
        { "value": "overlay", "label": "Overlay: heading on the photograph" }
      ],
      "default": "stacked",
      "info": "Use Overlay only with a photograph composed for type: subject in the right third, a calm, darker lower left. Otherwise keep Stacked."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Essentials for dogs and cats"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For the life you share"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic ending",
      "default": "with them."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A small collection for everyday life with a dog or cat. Everything in it is here for a reason."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Secondary link label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Secondary link"
    },
    {
      "type": "checkbox",
      "id": "hide_link_mobile",
      "label": "Hide secondary link on phones",
      "default": true
    },
    {
      "type": "header",
      "content": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph (tablet and desktop)",
      "info": "Horizontal. Set the focal point on the subject; it is kept in frame when the photograph is cropped."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photograph (phones)",
      "info": "Optional. Vertical, 4:5."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description"
    },
    {
      "type": "select",
      "id": "overlay_tone",
      "label": "Overlay: text colour",
      "options": [
        { "value": "light", "label": "Light (on a darker photograph)" },
        { "value": "dark", "label": "Dark (on a lighter photograph)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "legibility",
      "label": "Overlay: legibility shade",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Leave at 0 unless the text is hard to read. A soft shade in the lower left only, behind the text."
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "product",
      "id": "teaser_product",
      "label": "Product",
      "info": "Optional. A small card in the corner of the photograph (tablet and desktop)."
    },
    {
      "type": "text",
      "id": "teaser_label",
      "label": "Card label",
      "default": "New · No. 01"
    },
    {
      "type": "text",
      "id": "teaser_title",
      "label": "Card title",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "teaser_text",
      "label": "Card text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Home · Opener"
    }
  ]
}
{% endschema %}
