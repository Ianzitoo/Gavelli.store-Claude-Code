{%- comment -%}
  GAVELLI — product page, how it works (PDP V2). Three steps, text only.
{%- endcomment -%}

<section class="gvp gvp-steps color-{{ section.settings.color_scheme }} gradient" aria-labelledby="GvpSteps-{{ section.id }}">
  <div class="page-width">
    <div class="gvp-steps__head" data-gv-reveal>
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="gvp-h2" id="GvpSteps-{{ section.id }}">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif -%}
      </h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="gvp-steps__list" role="list">
        {%- for block in section.blocks -%}
          <li class="gvp-step" {{ block.shopify_attributes }} data-gv-reveal style="--gv-delay: {{ forloop.index0 | times: 0.08 }}s;">
            <span class="gvp-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="gvp-step__title">{{ block.settings.title | escape }}</h3>
            <p class="gvp-step__text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product · Steps",
  "tag": "div",
  "class": "section-gvp-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set up once." },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic phrase", "default": "Then leave it to it." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Product · Steps" }]
}
{% endschema %}
