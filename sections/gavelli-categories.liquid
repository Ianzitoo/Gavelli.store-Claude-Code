{%- comment -%}
  GAVELLI — "For dogs / For cats" (editorial entry points).
  Two (or up to three) large, asymmetric panels rather than a product grid.
  The first panel is wider and taller; the next is offset lower.
  A panel is only a link when a destination is set (no empty collections).
  On the storefront the whole section stays hidden until at least one panel
  has a real destination (a collection with products, or a custom link), so
  no one sees dead "Shop for dogs" tiles. In the theme editor it always shows.
{%- endcomment -%}

{%- liquid
  assign active_panels = 0
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign active_panels = active_panels | plus: 1
    elsif block.settings.link != blank
      assign active_panels = active_panels | plus: 1
    endif
  endfor
-%}

{%- if active_panels > 0 or request.design_mode -%}
<style>
  .gv-cats__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2.4rem;
    margin-bottom: var(--gv-space-sm);
  }

  .gv-cats__head .gv-h2 { max-width: 16ch; margin-top: 1.6rem; }

  .gv-cats__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gv-space-sm);
  }

  .gv-cats__item { display: block; color: inherit; text-decoration: none; }

  .gv-cats__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6rem;
    margin-top: 2rem;
  }

  .gv-cats__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: var(--gv-t-h3);
    line-height: 1.1;
    color: rgb(var(--color-foreground));
  }

  .gv-cats__text { margin-top: 1rem; }

  .gv-cats__more {
    flex: 0 0 auto;
    font-size: 1.15rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.78);
  }

  .gv-cats__item .gv-media img { transition: transform 1.6s var(--gv-ease-out); }

  @media (hover: hover) {
    a.gv-cats__item:hover .gv-media img { transform: scale(1.03); }
    a.gv-cats__item:hover .gv-cats__more { color: rgb(var(--color-foreground)); }
  }

  @media screen and (min-width: 750px) {
    .gv-cats__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--gv-gap-lg);
      align-items: start;
    }

    .gv-cats__item:nth-child(2) { margin-top: var(--gv-space-md); }
    .gv-cats__item:nth-child(3) { grid-column: 1 / -1; width: 58%; margin-left: auto; }
  }
</style>

<section
  class="gv-cats color-{{ section.settings.color_scheme }} gradient gv-pt-{{ section.settings.spacing_top }} gv-pb-{{ section.settings.spacing_bottom }}"
  aria-labelledby="GvCats-{{ section.id }}"
>
  <div class="page-width">
    <header class="gv-cats__head">
      <div>
        {%- if section.settings.label != blank -%}
          <p class="gv-label" data-gv-reveal="fade">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        <h2 id="GvCats-{{ section.id }}" class="gv-h2" data-gv-reveal>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="gv-body" data-gv-reveal style="--gv-delay: 0.1s;">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="gv-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          comment
            Destination: the chosen collection once it has products (e.g.
            /collections/dogs), otherwise the custom link, otherwise none —
            the panel is then not clickable, so no one lands on an empty page.
          endcomment
          assign href = ''
          assign entry_collection = block.settings.collection
          if entry_collection != blank and entry_collection.products_count > 0
            assign href = entry_collection.url
          elsif block.settings.link != blank
            assign href = block.settings.link
          endif
          assign tag = 'div'
          if href != blank
            assign tag = 'a'
          endif
          assign entry_alt = block.settings.image_alt | default: block.settings.image.alt
          if forloop.index == 1
            assign ratio = '4 / 5'
          else
            assign ratio = '3 / 4'
          endif
        -%}
        <{{ tag }}
          class="gv-cats__item"
          {% if tag == 'a' %}href="{{ href }}"{% endif %}
          style="--gv-delay: {{ forloop.index0 | times: 0.12 }}s;"
          {{ block.shopify_attributes }}
        >
          <div class="gv-media{% if section.settings.parallax %} gv-parallax{% endif %}" style="--gv-ratio: {{ ratio }};" data-gv-reveal="media">
            {%- if block.settings.image != blank -%}
              <div class="gv-media__layer">
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '500, 800, 1100, 1400, 1800',
                    sizes: '(min-width: 750px) 55vw, 100vw',
                    alt: entry_alt
                }}
              </div>
            {%- else -%}
              <div class="gv-placeholder" role="img" aria-label="{{ block.settings.placeholder_note | escape }}">
                <span class="gv-placeholder__label">Photograph to come</span>
                <span class="gv-placeholder__note">{{ block.settings.placeholder_note | escape }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="gv-cats__caption" data-gv-reveal>
            <div>
              <h3 class="gv-cats__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="gv-body gv-cats__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            {%- if tag == 'a' and block.settings.link_label != blank -%}
              <span class="gv-cats__more" aria-hidden="true">{{ block.settings.link_label | escape }}</span>
            {%- endif -%}
          </div>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "GAVELLI for dogs / cats",
  "class": "section-gavelli-categories",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The GAVELLI world" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For dogs. For cats." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "parallax", "label": "Subtle parallax on scroll", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "spacing_top", "label": "Space above",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "lg"
    },
    {
      "type": "select", "id": "spacing_bottom", "label": "Space below",
      "options": [{ "value": "none", "label": "None" }, { "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "lg"
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "For dogs" },
        { "type": "text", "id": "text", "label": "Short text" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "E.g. Dogs (/collections/dogs). The panel links to it as soon as it has products." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Used when no collection is chosen or it is still empty. Leave both blank and the panel is simply not clickable." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Editorial portrait: 4:5 for the first panel, 3:4 for the second. At least 1600 px wide." },
        { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Leave blank to use the image's own alt text." },
        { "type": "textarea", "id": "placeholder_note", "label": "Photograph needed (shown until an image is added)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GAVELLI for dogs / cats",
      "blocks": [
        { "type": "entry", "settings": { "title": "For dogs" } },
        { "type": "entry", "settings": { "title": "For cats" } }
      ]
    }
  ]
}
{% endschema %}
