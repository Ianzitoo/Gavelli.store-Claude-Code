{%- comment -%}
  GAVELLI — product page, details and questions (PDP V2).
  Left: the confirmed facts, as a quiet list. Right: only the questions that
  can stop a purchase, plus a way to write to us.
{%- endcomment -%}

<section class="gvp gvp-details color-{{ section.settings.color_scheme }} gradient" aria-labelledby="GvpDetails-{{ section.id }}">
  <div class="page-width gvp-details__grid">
    <div class="gvp-details__specs" data-gv-reveal>
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="gvp-h2 gvp-h2--sm" id="GvpDetails-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <dl class="gvp-spec">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' and block.settings.value != blank -%}
            <div class="gvp-spec__row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.name | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>

    <div class="gvp-details__faq" data-gv-reveal style="--gv-delay: 0.08s;">
      {%- if section.settings.faq_label != blank -%}
        <p class="gv-label">{{ section.settings.faq_label | escape }}</p>
      {%- endif -%}
      <div class="gvp-faq">
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.answer != blank -%}
            <details class="gvp-faq__item" {{ block.shopify_attributes }}>
              <summary class="gvp-faq__q">{{ block.settings.question | escape }}</summary>
              <div class="gvp-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.contact_note != blank -%}
        <div class="gvp-faq__more">{{ section.settings.contact_note }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product · Details",
  "tag": "div",
  "class": "section-gvp-details",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The details." },
    { "type": "text", "id": "faq_label", "label": "Questions label", "default": "Questions" },
    { "type": "richtext", "id": "contact_note", "label": "Note under the questions" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "value", "label": "Value", "info": "Rows without a value are not shown. Only confirmed facts." }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "Questions without an answer are not shown." }
      ]
    }
  ],
  "presets": [{ "name": "Product · Details" }]
}
{% endschema %}
