{%- comment -%}
  GAVELLI — full-bleed photograph with a text card (brand moment).
  The card is a solid panel, so the text never depends on the photograph.
  Desktop: card on the lower left of the photograph; phones: the card
  overlaps the bottom of the photograph and continues on the ground.
  Optional scroll parallax (CSS only, off for reduced motion).
  The photograph is not a link, so it has no hover effect.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign focal = image.presentation.focal_point | default: '50% 50%'
  assign focal_style = '--gv-focal: ' | append: focal | append: ';'
-%}

<section class="gvh gvh-fimage color-{{ section.settings.color_scheme }} gradient">
  <div class="gv-media gvh-fimage__media{% if section.settings.parallax %} gv-parallax{% endif %}" data-gv-reveal="media">
    <div class="gv-media__layer">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2800
          | image_tag:
            loading: 'lazy',
            widths: '750, 1100, 1500, 2000, 2800',
            sizes: '100vw',
            alt: section.settings.image_alt | default: image.alt,
            style: focal_style
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="gvh-fimage__overlay">
    <div class="page-width">
      <div class="gvh gvh-fimage__card color-{{ section.settings.card_color_scheme }}" data-gv-reveal>
        {%- if section.settings.label != blank -%}
          <p class="gv-label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        <h2 class="gvh-card-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="gvh-body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="gv-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home · Photograph + card",
  "tag": "div",
  "class": "section-gvh-image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Horizontal. Keep the subject away from the lower left, where the card sits."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Gentle scroll parallax",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Why Gavelli"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fewer, better things for everyday life with pets."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "About Gavelli"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card colour scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Home · Photograph + card"
    }
  ]
}
{% endschema %}
