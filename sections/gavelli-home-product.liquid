{%- comment -%}
  GAVELLI — homepage product feature ("the first piece").
  One product on a stone stage, with its finish picker, three steps and a
  real Add to basket (Dawn's <product-form>, so the basket notification
  works exactly as on the product page).

  - The picker appears for products with a single option (e.g. Finish).
    Products with more options link to their page instead of adding here.
  - The photograph follows the chosen variant when the variant has its own
    image (0.6s crossfade).
  - Sold out / unavailable variants disable the button and say so.
  Renders nothing for customers when the product is not available to the
  online store; shows a note in the theme editor.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
-%}

{%- if product != blank -%}
  {{ 'gavelli-home.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign single_option = false
    if product.has_only_default_variant == false and product.options.size == 1
      assign single_option = true
    endif

    assign variant_media = ','
    for v in product.variants
      if v.featured_media
        assign variant_media = variant_media | append: v.featured_media.id | append: ','
      endif
    endfor

    assign active_media = variant.featured_media.id | default: product.featured_media.id
    assign form_id = 'GvhProductForm-' | append: section.id
    assign fit = section.settings.image_fit | default: 'cover'
  -%}

  <gvh-product class="gvh gvh-product gvh-product--{{ fit }} gvh-pad-md color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'the-first-piece' | handleize }}">
    <div class="page-width gvh-product__inner gvh-grid">
      <div class="gvh-product__figure">
        {%- if section.settings.number != blank or section.settings.category != blank -%}
          <p class="gvh-product__marks">
            <span class="gvh-product__mark gvh-product__mark--no">{{ section.settings.number | escape }}</span>
            <span class="gvh-product__mark">{{ section.settings.category | escape }}</span>
          </p>
        {%- endif -%}
        <div class="gvh-product__stage" data-gv-reveal="media">
          {%- assign shown = 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign key = ',' | append: media.id | append: ','
              assign include = false
              if media.id == product.featured_media.id or variant_media contains key
                assign include = true
              endif
            -%}
            {%- if include and media.preview_image -%}
              {%- assign shown = shown | plus: 1 -%}
              <div
                class="gvh-product__visual{% if media.id == active_media %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                {% unless media.id == active_media %}aria-hidden="true"{% endunless %}
              >
                {{
                  media.preview_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 55vw, calc(100vw - 3rem)',
                    alt: media.alt | default: product.title
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 -%}
            <div class="gvh-product__visual is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
      </div>

      <div class="gvh-product__info" data-gv-reveal>
        <div class="gvh-product__intro">
          {%- if section.settings.label != blank -%}
            <p class="gv-label">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          <h2 class="gvh-h2">{{ section.settings.heading | default: product.title | escape }}</h2>
          <div class="gvh-lede">
            {%- if section.settings.text != blank -%}
              {{ section.settings.text }}
            {%- else -%}
              <p>{{ product.description | strip_html | truncatewords: 36 }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="gvh-product__buyline">
          <p class="gvh-product__price" data-gvh-price>
            {{- variant.price | money -}}
            {%- if variant.compare_at_price > variant.price -%}
              <s>{{ variant.compare_at_price | money }}</s>
            {%- endif -%}
          </p>

          {%- if single_option -%}
            {%- assign option = product.options_with_values.first -%}
            <fieldset class="gvh-picker">
              <legend class="gvh-picker__legend">
                {{- option.name | escape }} — <span data-gvh-selected>{{ option.selected_value | escape }}</span>
              </legend>
              <div class="gvh-picker__options">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch = value.swatch.color
                    if swatch == blank
                      assign name = value.name | downcase
                      case name
                        when 'black', 'noir', 'charcoal'
                          assign swatch = '#232220'
                        when 'white', 'ivory', 'cream'
                          assign swatch = '#F7F5F0'
                        when 'grey', 'gray', 'stone'
                          assign swatch = '#9A968E'
                      endcase
                    endif
                    assign input_id = section.id | append: '-opt-' | append: forloop.index
                  -%}
                  <div class="gvh-swatch">
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      name="{{ section.id }}-option"
                      value="{{ value.name | escape }}"
                      data-gvh-option
                      {% if value.selected %}checked{% endif %}
                    >
                    <label for="{{ input_id }}" title="{{ value.name | escape }}">
                      {%- if swatch != blank -%}
                        <span class="gvh-swatch__dot" style="--gvh-swatch: {{ swatch }};"></span>
                        <span class="visually-hidden">{{ value.name | escape }}</span>
                      {%- else -%}
                        <span class="gvh-swatch__text">{{ value.name | escape }}</span>
                      {%- endif -%}
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ol class="gvh-steps" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="gvh-numeral">{{ forloop.index | prepend: '0' | slice: -2, 2 }} {{ block.settings.title | escape }}</span>
                <p>{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <div class="gvh-product__actions">
          {%- if single_option or product.has_only_default_variant -%}
            <product-form class="gvh-product__form" data-section-id="{{ section.id }}">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <p class="gvh-product__error"><span class="product-form__error-message"></span></p>
              </div>
              {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
                <button
                  type="submit"
                  name="add"
                  class="button product-form__submit"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span data-gvh-button-label>
                    {%- if variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <a class="button" href="{{ product.url }}">{{ 'products.product.choose_options' | t }}</a>
          {%- endif -%}

          <div class="gvh-product__meta">
            <a class="gv-link" href="{{ variant.url | default: product.url }}" data-gvh-details>
              {{- 'products.product.view_full_details' | t -}}
            </a>
            {%- if section.settings.note != blank -%}
              <p class="gvh-note">{{ section.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" data-gvh-variants>
      [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "option1": {{ v.option1 | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money | json }},
            "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "media": {{ v.featured_media.id | default: 'null' }},
            "url": {{ v.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </gvh-product>

  <script>
    if (!customElements.get('gvh-product')) {
      customElements.define('gvh-product', class extends HTMLElement {
        connectedCallback() {
          const data = this.querySelector('[data-gvh-variants]');
          this.variants = data ? JSON.parse(data.textContent) : [];
          this.addEventListener('change', (event) => {
            if (event.target.matches('[data-gvh-option]')) this.select(event.target.value);
          });
        }

        select(value) {
          const variant = this.variants.find((v) => v.option1 === value);
          if (!variant) return;

          const input = this.querySelector('input[name="id"]');
          if (input) input.value = variant.id;

          const price = this.querySelector('[data-gvh-price]');
          if (price) {
            price.textContent = variant.price;
            if (variant.compare) {
              const s = document.createElement('s');
              s.textContent = variant.compare;
              price.appendChild(s);
            }
          }

          const selected = this.querySelector('[data-gvh-selected]');
          if (selected) selected.textContent = value;

          const details = this.querySelector('[data-gvh-details]');
          if (details && variant.url) details.href = variant.url;

          const button = this.querySelector('.product-form__submit');
          const label = this.querySelector('[data-gvh-button-label]');
          const strings = window.variantStrings || {};
          if (button) button.toggleAttribute('disabled', !variant.available);
          if (label) label.textContent = variant.available ? strings.addToCart : strings.soldOut;

          if (variant.media) {
            const next = this.querySelector('[data-media-id="' + variant.media + '"]');
            if (next) {
              this.querySelectorAll('.gvh-product__visual').forEach((el) => {
                const on = el === next;
                el.classList.toggle('is-active', on);
                el.toggleAttribute('aria-hidden', !on);
              });
            }
          }
        }
      });
    }
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 4rem 1.5rem;">
    <p class="gv-todo">GAVELLI home: product. Choose a product. It only appears to customers once the product is available on the online store.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Home · First piece",
  "tag": "div",
  "class": "section-gvh-product",
  "max_blocks": 3,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The first piece"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Leave blank to use the start of the product description."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note beside the details link",
      "info": "One short fact, e.g. what is in the box."
    },
    {
      "type": "header",
      "content": "Stage"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "No. 01"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category",
      "default": "Feeding"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photograph",
      "options": [
        { "value": "cover", "label": "Fill the stage (lifestyle or studio photograph)" },
        { "value": "contain", "label": "Product on the stone ground (cut-out)" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "the-first-piece",
      "info": "Lets other links jump here, e.g. #the-first-piece"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Set up"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home · First piece"
    }
  ]
}
{% endschema %}
