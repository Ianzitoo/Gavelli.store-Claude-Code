{%- comment -%}
  GAVELLI — "Ordinary Hours" (Phase B).
  One house through one day, and the routine that keeps to time while yours
  changes. The section keeps one ground (Linen by default) and the change of
  light stays in the photograph; set "Ground" to "Follow the hour" to move
  the ground to each hour's tone instead. Nothing plays by itself.

  One markup, two behaviours:
  - Below 990px: a row of scenes swiped sideways (scroll-snap), each a card
    with its photograph (4:5), time, title and text; the next scene shows at
    the edge. The times above are an index: tapping one scrolls to its scene,
    and the visible scene is marked (aria-current). The row itself takes
    keyboard focus and scrolls with the arrow keys.
  - From 990px: heading left, the times as tabs right (ARIA tablist: arrow
    keys, Home, End). Below, the photograph in columns 1–7, nearly square,
    and the caption in columns 9–12, on the photograph's bottom line.
  - Reduced motion: no animated scroll or crossfade.
{%- endcomment -%}

{%- liquid
  assign ground = section.settings.ground | default: 'linen'
  assign follow_hour = false
  if ground == 'hour'
    assign follow_hour = true
    assign ground = section.blocks.first.settings.tone | default: 'linen'
  endif
-%}

<gvh-hours
  class="gvh gvh-hours gvh-rhythm"
  data-tone="{{ ground }}"
  {% if follow_hour %}data-follow-hour{% endif %}
  id="{{ section.settings.anchor | default: 'ordinary-hours' | handleize }}"
  aria-labelledby="GvhHoursHeading-{{ section.id }}"
  role="region"
>
  <div class="page-width gvh-hours__top">
    <div class="gvh-hours__head" data-gv-reveal>
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="gvh-h2" id="GvhHoursHeading-{{ section.id }}">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank %} <span class="gvh-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h2>
    </div>

    <div class="gvh-hours__tabs" aria-label="{{ section.settings.tabs_label | default: 'Times of day' | escape }}" data-gvh-hours-index>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="gvh-hours__tab"
          id="GvhHoursTab-{{ block.id }}"
          aria-controls="GvhHoursScene-{{ block.id }}"
          {% if forloop.first %}aria-current="true"{% endif %}
          data-tone="{{ block.settings.tone }}"
          {{ block.shopify_attributes }}
        >
          <span class="gvh-hours__time">{{ block.settings.time | escape }}</span>
          {%- if block.settings.name != blank -%}
            <span class="gvh-hours__name">{{ block.settings.name | escape }}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>

  <div class="page-width gvh-hours__body">
    <div
      class="gvh-hours__scenes"
      tabindex="0"
      role="group"
      aria-label="{{ section.settings.heading | escape }}"
      data-gvh-hours-scenes
    >
      {%- for block in section.blocks -%}
        <article
          class="gvh-hours__scene{% if forloop.first %} is-active{% endif %}"
          id="GvhHoursScene-{{ block.id }}"
          aria-labelledby="GvhHoursTitle-{{ block.id }}"
          data-gvh-hours-scene
        >
          <div class="gvh-hours__media">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign focal = block.settings.image.presentation.focal_point | default: '50% 50%'
                assign focal_style = '--gv-focal: ' | append: focal | append: ';'
                assign scene_alt = block.settings.image_alt | default: block.settings.image.alt
              -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1300, 1600',
                  sizes: '(min-width: 1440px) 75rem, (min-width: 990px) 52vw, 30rem',
                  alt: scene_alt,
                  style: focal_style
              }}
            {%- elsif request.design_mode -%}
              <span class="gvh-placeholder gvh-placeholder--dark">
                <span class="gvh-placeholder__label">Placeholder · {{ block.settings.time | escape }} photograph not yet chosen</span>
              </span>
            {%- endif -%}
          </div>
          <div class="gvh-hours__caption">
            <p class="gv-label gvh-hours__caption-time">{{ block.settings.time | escape }}</p>
            <h3 class="gvh-hours__title" id="GvhHoursTitle-{{ block.id }}">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="gvh-lede gvh-hours__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <p class="gvh-hours__more">
        <a class="gv-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</gvh-hours>

<script>
  if (!customElements.get('gvh-hours')) {
    customElements.define('gvh-hours', class extends HTMLElement {
      connectedCallback() {
        this.tabs = Array.from(this.querySelectorAll('.gvh-hours__tab'));
        this.scenes = Array.from(this.querySelectorAll('[data-gvh-hours-scene]'));
        this.index = this.querySelector('[data-gvh-hours-index]');
        this.track = this.querySelector('[data-gvh-hours-scenes]');
        this.active = 0;
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.desktop = window.matchMedia('(min-width: 990px)');

        this.tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => this.go(i));
          tab.addEventListener('keydown', (event) => this.onKey(event, i));
        });

        this.track.addEventListener('scroll', () => {
          if (this.isDesktop()) return;
          cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.syncFromScroll());
        }, { passive: true });

        this.onMode = () => this.applyMode();
        this.desktop.addEventListener('change', this.onMode);
        this.applyMode();
      }

      disconnectedCallback() {
        this.desktop.removeEventListener('change', this.onMode);
      }

      isDesktop() {
        return this.desktop.matches;
      }

      // Tabs on desktop, a scrolling index on phones and tablets.
      applyMode() {
        const desktop = this.isDesktop();
        if (desktop) {
          this.index.setAttribute('role', 'tablist');
          this.track.removeAttribute('tabindex');
          this.track.removeAttribute('role');
        } else {
          this.index.removeAttribute('role');
          this.track.setAttribute('tabindex', '0');
          this.track.setAttribute('role', 'group');
        }
        this.tabs.forEach((tab) => {
          if (desktop) tab.setAttribute('role', 'tab');
          else tab.removeAttribute('role');
        });
        this.scenes.forEach((scene) => {
          if (desktop) {
            scene.setAttribute('role', 'tabpanel');
            scene.setAttribute('aria-labelledby', scene.id.replace('Scene', 'Tab'));
          } else {
            scene.removeAttribute('role');
            scene.setAttribute('aria-labelledby', scene.id.replace('Scene', 'Title'));
          }
        });
        this.mark(this.active);
        if (!desktop) this.scrollToScene(this.active, false);
      }

      onKey(event, index) {
        if (!this.isDesktop()) return;
        const last = this.tabs.length - 1;
        let next = null;
        if (event.key === 'ArrowRight') next = index === last ? 0 : index + 1;
        if (event.key === 'ArrowLeft') next = index === 0 ? last : index - 1;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = last;
        if (next === null) return;
        event.preventDefault();
        this.go(next);
        this.tabs[next].focus();
      }

      go(index) {
        if (this.isDesktop()) this.mark(index);
        else this.scrollToScene(index, !this.reduce);
      }

      scrollToScene(index, smooth) {
        const scene = this.scenes[index];
        if (!scene) return;
        const left = scene.offsetLeft - this.scenes[0].offsetLeft;
        this.track.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
        this.mark(index);
      }

      syncFromScroll() {
        const x = this.track.scrollLeft;
        const start = this.scenes[0].offsetLeft;
        let nearest = 0;
        this.scenes.forEach((scene, i) => {
          if (Math.abs(scene.offsetLeft - start - x) < Math.abs(this.scenes[nearest].offsetLeft - start - x)) nearest = i;
        });
        // At the end of the row the last card cannot reach the start edge.
        if (x + this.track.clientWidth >= this.track.scrollWidth - 2) nearest = this.scenes.length - 1;
        if (nearest !== this.active) this.mark(nearest);
      }

      mark(index) {
        this.active = index;
        const desktop = this.isDesktop();
        this.tabs.forEach((tab, i) => {
          const on = i === index;
          if (desktop) {
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            tab.removeAttribute('aria-current');
          } else {
            tab.removeAttribute('aria-selected');
            tab.removeAttribute('tabindex');
            if (on) tab.setAttribute('aria-current', 'true');
            else tab.removeAttribute('aria-current');
          }
        });
        this.scenes.forEach((scene, i) => {
          const on = i === index;
          scene.classList.toggle('is-active', on);
          if (desktop && !on) scene.setAttribute('aria-hidden', 'true');
          else scene.removeAttribute('aria-hidden');
        });
        if (this.hasAttribute('data-follow-hour')) {
          const tone = this.tabs[index] && this.tabs[index].dataset.tone;
          if (tone) this.dataset.tone = tone;
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Home · Ordinary Hours",
  "tag": "div",
  "class": "section-gvh-hours",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Ordinary hours"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A day that keeps to time."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic ending"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Name of the time list (screen readers)",
      "default": "Times of day"
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Ground",
      "options": [
        { "value": "linen", "label": "Linen" },
        { "value": "paper", "label": "Paper" },
        { "value": "stone", "label": "Stone" },
        { "value": "ink", "label": "Ink" },
        { "value": "hour", "label": "Follow the hour" }
      ],
      "default": "linen",
      "info": "One ground for the whole section; the light changes in the photograph. 'Follow the hour' uses each moment's own ground."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Closing link",
      "default": "See how the feeder works"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Closing link destination"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "ordinary-hours"
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "07:30"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Short name",
          "default": "Breakfast",
          "info": "Under the time in the desktop tabs."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Breakfast, unhurried."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "One or two sentences."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph",
          "info": "3:2 or squarer, 2000px or more. Shown 4:5 on phones and nearly square on desktop; set the focal point."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photograph description"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Ground at this hour",
          "info": "Used only when the section's Ground is 'Follow the hour'.",
          "options": [
            { "value": "linen", "label": "Linen (morning)" },
            { "value": "paper", "label": "Paper (midday)" },
            { "value": "stone", "label": "Stone (evening)" },
            { "value": "ink", "label": "Ink (night)" }
          ],
          "default": "linen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home · Ordinary Hours"
    }
  ]
}
{% endschema %}
