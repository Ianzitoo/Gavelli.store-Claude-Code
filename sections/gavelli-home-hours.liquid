{%- comment -%}
  GAVELLI — "The ordinary hours".
  Four moments of an ordinary day. Choosing a time opens its text and
  brings its photograph forward; at the mealtimes marked "Show the product",
  the moment says how the product fits into it, with a link.

  The first moment is open on load, so the idea (and the product's place in
  the routine) reads without any interaction. One moment is always open.

  Desktop: list on the left, one photograph on the right (sticky while the
  list is read). Phones: each moment carries its own photograph inside its
  panel, so what changes is always in view.
  Accessible: buttons with aria-expanded, closed panels are inert.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

{%- assign product = section.settings.product -%}

<gvh-hours class="gvh gvh-hours gvh-pad-md color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'ordinary-hours' | handleize }}">
  <div class="page-width gvh-hours__inner gvh-grid">
    <div class="gvh-hours__text">
      <div class="gvh-hours__head" data-gv-reveal>
        {%- if section.settings.label != blank -%}
          <p class="gv-label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        <h2 class="gvh-h2">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank %} <span class="gvh-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
        </h2>
        {%- if section.settings.intro != blank -%}
          <div class="gvh-lede gvh-hours__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      <ul class="gvh-hours__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign open = false
            if forloop.first
              assign open = true
            endif
            assign btn_id = 'GvhHoursBtn-' | append: block.id
            assign panel_id = 'GvhHoursPanel-' | append: block.id
            assign caption = block.settings.time | append: ' — ' | append: block.settings.title
          -%}
          <li class="gvh-hours__item{% if open %} is-open{% endif %}" data-caption="{{ caption | escape }}" {{ block.shopify_attributes }}>
            <h3 class="gvh-hours__q">
              <button
                type="button"
                class="gvh-hours__btn"
                id="{{ btn_id }}"
                aria-expanded="{{ open }}"
                aria-controls="{{ panel_id }}"
              >
                <span class="gvh-hours__time">{{ block.settings.time | escape }}</span>
                <span class="gvh-hours__title">{{ block.settings.title | escape }}</span>
              </button>
            </h3>
            <div
              class="gvh-hours__panel"
              id="{{ panel_id }}"
              role="region"
              aria-labelledby="{{ btn_id }}"
              {% unless open %}inert{% endunless %}
            >
              <div class="gvh-hours__panel-inner">
                {%- if block.settings.image != blank -%}
                  <div class="gvh-hours__panel-image large-up-hide">
                    {{
                      block.settings.image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '500, 750, 1000',
                        sizes: 'calc(100vw - 3rem)',
                        alt: block.settings.image_alt | default: block.settings.image.alt
                    }}
                  </div>
                {%- endif -%}
                <div class="gvh-hours__panel-body">
                  {%- if block.settings.text != blank -%}
                    <div class="gvh-body">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.show_product and product != blank -%}
                    <div class="gvh-hours__tie">
                      {%- if section.settings.product_note != blank -%}
                        <p>{{ section.settings.product_note | escape }}</p>
                      {%- endif -%}
                      <a class="gv-link" href="{{ product.url }}">
                        {{- section.settings.product_link_label | default: product.title | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="gvh-hours__visual small-hide medium-hide" data-gv-reveal="media">
      <div class="gvh-hours__frame">
        {%- for block in section.blocks -%}
          <div
            class="gvh-hours__image{% if forloop.first %} is-active{% endif %}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
          >
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign focal = block.settings.image.presentation.focal_point | default: '50% 50%'
                assign focal_style = '--gv-focal: ' | append: focal | append: ';'
              -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '700, 1000, 1400',
                  sizes: '(min-width: 990px) 48vw, 100vw',
                  alt: block.settings.image_alt | default: block.settings.image.alt,
                  style: focal_style
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <p class="gvh-hours__caption" data-gvh-caption>
          {{- section.blocks.first.settings.time | escape }} — {{ section.blocks.first.settings.title | escape -}}
        </p>
      {%- endif -%}
    </div>
  </div>
</gvh-hours>

<script>
  if (!customElements.get('gvh-hours')) {
    customElements.define('gvh-hours', class extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.gvh-hours__item'));
        this.images = Array.from(this.querySelectorAll('.gvh-hours__image'));
        this.caption = this.querySelector('[data-gvh-caption]');
        this.items.forEach((item, index) => {
          const button = item.querySelector('.gvh-hours__btn');
          if (button) button.addEventListener('click', () => this.open(index));
        });
      }

      open(index) {
        this.items.forEach((item, i) => {
          const on = i === index;
          item.classList.toggle('is-open', on);
          item.querySelector('.gvh-hours__btn').setAttribute('aria-expanded', on);
          item.querySelector('.gvh-hours__panel').toggleAttribute('inert', !on);
        });
        this.images.forEach((image, i) => {
          image.classList.toggle('is-active', i === index);
          image.toggleAttribute('aria-hidden', i !== index);
        });
        if (this.caption && this.items[index]) this.caption.textContent = this.items[index].dataset.caption;
      }
    });
  }
</script>

{% schema %}
{
  "name": "Home · Ordinary hours",
  "tag": "div",
  "class": "section-gvh-hours",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "A day, considered"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The ordinary hours."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic ending"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shown in the moments marked \"Show the product\"."
    },
    {
      "type": "text",
      "id": "product_note",
      "label": "What the product does in these moments",
      "default": "Set mealtimes in the app, and the feeder keeps to them."
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "Link label",
      "default": "Meet the Smart Feeder"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "ordinary-hours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "07:30"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Breakfast, unhurried."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph",
          "info": "Square. Set the focal point on the animal."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photograph description"
        },
        {
          "type": "checkbox",
          "id": "show_product",
          "label": "Show the product in this moment",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home · Ordinary hours"
    }
  ]
}
{% endschema %}
