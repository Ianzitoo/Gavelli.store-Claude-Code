{%- comment -%}
  GAVELLI — "How we choose", as three questions.
  The page's one statement of values, on the dark ground. Numbers are
  automatic. Links: how we choose (about page) and a direct line for
  questions before ordering.
{%- endcomment -%}

{{ 'gavelli-home.css' | asset_url | stylesheet_tag }}

<section class="gvh gvh-questions gvh-pad-lg color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'how-we-choose' | handleize }}">
  <div class="page-width">
    <div class="gvh-questions__row gvh-grid" data-gv-reveal>
      {%- if section.settings.label != blank -%}
        <p class="gv-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="gvh-h2-sm">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank %} <span class="gvh-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gvh-questions__row gvh-grid">
        <ol class="gvh-questions__list" role="list">
          {%- for block in section.blocks -%}
            <li class="gvh-questions__item" data-gv-reveal style="--gv-delay: {{ forloop.index0 | times: 0.08 }}s;" {{ block.shopify_attributes }}>
              <span class="gvh-questions__num" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="gvh-questions__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- if section.settings.link_label != blank or section.settings.link_2_label != blank -%}
      <div class="gvh-questions__row gvh-grid">
        <div class="gvh-questions__links">
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="gv-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.link_2_label != blank and section.settings.link_2 != blank -%}
            <a class="gv-link" href="{{ section.settings.link_2 }}">{{ section.settings.link_2_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home · How we choose",
  "tag": "div",
  "class": "section-gvh-questions",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "How we choose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We look at what a product does, how it fits into everyday life, and whether it"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, italic ending",
      "default": "earns its place at home."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "First link label",
      "default": "Read how we choose"
    },
    {
      "type": "url",
      "id": "link",
      "label": "First link"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Second link label",
      "default": "Ask us before you order"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Second link"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "how-we-choose"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "What does it actually do?"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home · How we choose"
    }
  ]
}
{% endschema %}
